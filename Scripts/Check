#!/bin/bash

set -euo pipefail

owner="$1"
repository="$2"

if [ ! -d "$repository" ]; then
    git clone -q "https://github.com/${owner}/${repository}"
fi

cd "$repository"

blacklisted_domains=(
    "@gmail\.com"
    "@yahoo\.com"
    "@hotmail\.com"
    "@outlook\.com"
    "@aol\.com"
    "@icloud\.com"
    "@sasktel\.net"
    "@anthropic\.com"
    "@openai\.com"
    "@alibabacloud\.com"
    "@alibaba-inc\.com"
    "@google\.com"
    "google-labs-jules\[bot\]@"
)
blacklist_pattern=$(IFS="|"; echo "${blacklisted_domains[*]}")

# if there are no emails, grep will also fail, which is why coalescence is needed
# co-author trailers count too, because GitHub attributes the commit to every address in them
insecure_emails_history=$(git log --format="%ae %ce%n%(trailers:valueonly)" | sort -u | grep -E -i "$blacklist_pattern" | wc -l || true)

if [ "$insecure_emails_history" -ne "0" ]; then
    echo "found ${insecure_emails_history} insecure email addresses in git history of repo '${repository}'!"
    exit 1
fi

if [ -f .mailmap ]; then
    insecure_emails_mailmap=$(grep -E -i "$blacklist_pattern" .mailmap | sort -u | wc -l || true)
    if [ "$insecure_emails_mailmap" -ne "0" ]; then
        echo "found ${insecure_emails_mailmap} insecure email addresses in .mailmap of repo '${repository}'!"
        exit 1
    fi
fi
