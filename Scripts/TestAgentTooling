#!/bin/bash

set -euo pipefail

tool="Templates/Tools/lsp_query.py"
sample="Sources/Rarestcheck/Rarestcheck.swift"
macro_dir="Scripts/SampleProject"
macro_sample="${macro_dir}/Sources/Sample/main.swift"

echo "testing agent tooling (${tool})..."

# Test help
python3 "$tool" --help > /dev/null

# Test workspace symbol query
python3 "$tool" --dir . symbol Rarestcheck | jq empty

# Test definition lookup
python3 "$tool" --dir . definition "$sample" 1 1 | jq empty

# Test hover documentation lookup
python3 "$tool" --dir . hover "$sample" 1 1 | jq empty

# Test reference searching
python3 "$tool" --dir . references "$sample" 1 1 | jq empty

# Test macro expansion / previewing on attached macro (@Bijection)
python3 "$tool" --dir "$macro_dir" expand "$macro_sample" 9 10 | jq empty

# Test macro expansion / previewing on freestanding macro (#assert)
python3 "$tool" --dir "$macro_dir" expand "$macro_sample" 18 1 | jq empty

echo "agent tooling tests passed!"
